{
  "name": "dsh-enslave-agy",
  "version": "0.1.0",
  "description": "把 Antigravity CLI (agy) 接成 DSH 的 subagent provider",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    },
    "manifestVersion": 1
  },
  "license": "Beerware",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaiTeeDreamChai/dsh-Enslave-agy.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "antigravity",
    "agy",
    "subagent"
  ]
}
